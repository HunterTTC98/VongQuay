# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ========================================================
# FIREBASE FIRESTORE CONFIGURATION (CHO VERCEL / SERVERLESS)
# ========================================================
# Cách 1 (Khuyên Dùng): Dán toàn bộ nội dung JSON file Service Account tải từ Firebase Console:
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"jumping-earth-38f9p",...}'

# Cách 2: Khai báo tách rời từng biến:
# FIREBASE_PROJECT_ID="jumping-earth-38f9p"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@jumping-earth-38f9p.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...-----END PRIVATE KEY-----\n"
# FIREBASE_DATABASE_ID="ai-studio-vngquaymaymnskin-a23e33c2-22a1-4bd2-af1f-90f28bac5fd2"

# ADMIN_INITIAL_PASSWORD: Mật khẩu khởi tạo cho tài khoản admin lúc tạo lần đầu.
# Nếu bỏ trống, hệ thống tự động sinh ngẫu nhiên 16 ký tự an toàn và lưu vào .initial_admin_credential.
# ADMIN_INITIAL_PASSWORD="your_strong_password_here"

# SESSION_SECRET: Khóa bí mật ký mã xác thực JWT / HMAC session token.
# SESSION_SECRET="your_random_secret_key"
