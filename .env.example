# ========================================================
# BIẾN MÔI TRƯỜNG BẮT BUỘC TRÊN VERCEL PRODUCTION
# (Cấu hình tại: Vercel Dashboard -> Project Settings -> Environment Variables)
# ========================================================

# 1. SESSION_SECRET [BẮT BUỘC TRÊN VERCEL]:
# Khóa bí mật dùng để ký và xác thực token JWT/HMAC cho học sinh và quản trị viên.
# Bắt buộc cấu hình cố định trên Vercel để tránh mất phiên đăng nhập giữa các Serverless Function instances.
# Khuyến nghị chuỗi ngẫu nhiên tối thiểu 32 ký tự (ví dụ: openssl rand -hex 32):
SESSION_SECRET="your_very_long_random_session_secret_at_least_32_characters"

# 2. ADMIN_INITIAL_PASSWORD [BẮT BUỘC TRÊN VERCEL]:
# Mật khẩu khởi tạo ban đầu cho tài khoản quản trị viên "admin" khi chưa có admin nào trong database.
# Tối thiểu 8 ký tự. Hệ thống không in mật khẩu ra log trên môi trường production để bảo mật.
ADMIN_INITIAL_PASSWORD="YourStrongAdminPassword2026!"

# 3. FIREBASE FIRESTORE [BẮT BUỘC TRÊN VERCEL]:
# Kết nối cơ sở dữ liệu Google Cloud Firestore cho Vercel Serverless.
# Hệ thống sẽ báo lỗi và dừng ngay lập tức nếu thiếu cấu hình Firestore trên Production để tránh mất dữ liệu.

# Cách 1 (Khuyên Dùng): Dán toàn bộ nội dung JSON file Service Account tải từ Firebase Console:
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"jumping-earth-38f9p",...}'

# Cách 2 (Nếu không dùng JSON gộp): Cấu hình các biến riêng lẻ:
# FIREBASE_PROJECT_ID="jumping-earth-38f9p"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@jumping-earth-38f9p.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...-----END PRIVATE KEY-----\n"
# FIREBASE_DATABASE_ID="ai-studio-vngquaymaymnskin-a23e33c2-22a1-4bd2-af1f-90f28bac5fd2"

# ========================================================
# CẤU HÌNH BỔ SUNG (TÙY CHỌN HOẶC MÔI TRƯỜNG HỆ THỐNG)
# ========================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

