rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Zero-Trust Security Fortress:
    // All sensitive business operations (ticket verification, spins, prize deductions,
    // claim submissions, student logins, and admin actions) MUST go through the backend API server
    // which executes Firestore atomic transactions with server-authoritative validations.
    // Direct client writes and untrusted SDK tampering are strictly blocked by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
